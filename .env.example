# =============================================================
# Supabase Configuration
# -------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in your values from:
#    Supabase Dashboard → Project Settings → API
#
# ⚠️  NEVER commit .env.local — it is ignored in .gitignore.
#     This .env.example file IS safe to commit.
# =============================================================

# Your Supabase project URL (e.g. https://abcd1234.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon (public) key — safe for the browser.
# Do NOT use the service_role key here.
VITE_SUPABASE_ANON_KEY=your-anon-public-key